TITLE: Preview Files
:--------------------------------------------------------------------------------:
BOOKMARK: preview
:--------------------------------------------------------------------------------:
NOTE: Browse the current local directory from Developer Dashboard and preview text, images, pdf, audio, and video files inline.
:--------------------------------------------------------------------------------:
HTML: <script src="/js/jquery.js"></script>
<style>
.preview-shell { display:grid; grid-template-columns:minmax(280px, 360px) minmax(0, 1fr); gap:20px; color:#1d2a33; }
.preview-card { border:1px solid #d8d5cb; border-radius:22px; overflow:hidden; background:linear-gradient(180deg, #fffef8 0%, #f6f1e6 100%); box-shadow:0 18px 40px rgba(29,42,51,0.08); }
.preview-card header { padding:18px 20px; border-bottom:1px solid #e6dfd0; background:linear-gradient(180deg, #f6efe0 0%, #efe4cf 100%); }
.preview-card h2, .preview-card h3, .preview-card p { margin:0; }
.preview-card p { margin-top:8px; color:#596770; line-height:1.5; }
.preview-card section { padding:18px 20px; }
.preview-breadcrumbs { display:flex; gap:8px; flex-wrap:wrap; margin:0 0 14px; }
.preview-breadcrumbs button, .preview-toolbar button {
  border:1px solid #ccb98c;
  border-radius:999px;
  background:#fff8e7;
  color:#6a4c14;
  cursor:pointer;
  font-weight:700;
  padding:8px 14px;
}
.preview-breadcrumbs button.is-active { background:#dff1ec; color:#0f6b5c; border-color:#7ab6aa; }
.preview-toolbar { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:14px; }
.preview-status { padding:12px 14px; border-radius:14px; background:#f9f4e8; color:#6a4c14; margin-bottom:14px; }
.preview-list { list-style:none; margin:0; padding:0; display:grid; gap:8px; max-height:70vh; overflow:auto; }
.preview-list button {
  width:100%;
  text-align:left;
  border:1px solid #e1dccd;
  border-radius:16px;
  background:#fff;
  padding:12px 14px;
  cursor:pointer;
  display:grid;
  gap:4px;
}
.preview-list button:hover, .preview-list button.is-selected { border-color:#2d8c7c; box-shadow:0 0 0 2px rgba(45,140,124,0.12); }
.preview-entry-name { font-weight:800; }
.preview-entry-meta { font-size:0.9rem; color:#68767e; }
.preview-preview-area { min-height:72vh; display:grid; gap:14px; }
.preview-preview-meta { display:grid; gap:6px; }
.preview-preview-box {
  min-height:58vh;
  border:1px solid #ddd5c2;
  border-radius:18px;
  background:
    radial-gradient(circle at top left, rgba(238,226,195,0.45), transparent 38%),
    linear-gradient(180deg, #fbfaf5 0%, #efe8d9 100%);
  padding:18px;
  overflow:auto;
}
.preview-empty { color:#68767e; font-style:italic; }
.preview-preview-box pre { margin:0; white-space:pre-wrap; font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.preview-preview-box img,
.preview-preview-box iframe,
.preview-preview-box audio,
.preview-preview-box video {
  width:100%;
  max-width:100%;
  border:0;
  border-radius:14px;
  background:#fff;
}
.preview-preview-box iframe { min-height:62vh; }
@media (max-width: 920px) {
  .preview-shell { grid-template-columns:1fr; }
  .preview-list { max-height:none; }
  .preview-preview-area { min-height:0; }
  .preview-preview-box { min-height:42vh; }
}
</style>
<div class="preview-shell">
  <aside class="preview-card">
    <header>
      <h2>Local Preview</h2>
      <p>Run <code>dashboard preview.files</code> in the directory you want, then browse and preview its files here.</p>
    </header>
    <section>
      <div class="preview-status" id="preview-root-label">Loading current directory...</div>
      <div class="preview-toolbar">
        <button type="button" id="preview-root-button">Root</button>
        <button type="button" id="preview-up-button">Up</button>
      </div>
      <div class="preview-breadcrumbs" id="preview-breadcrumbs"></div>
      <ul class="preview-list" id="preview-list"></ul>
    </section>
  </aside>
  <section class="preview-card">
    <header>
      <h2>Preview Pane</h2>
      <p>Text opens inline. Images, pdf, audio, and video render directly in the page.</p>
    </header>
    <section class="preview-preview-area">
      <div class="preview-preview-meta">
        <h3 id="preview-selected-name">Nothing selected</h3>
        <p id="preview-selected-meta" class="preview-empty">Choose a file from the list to preview it.</p>
      </div>
      <div class="preview-preview-box" id="preview-preview-box">
        <div class="preview-empty">No file selected yet.</div>
      </div>
    </section>
  </section>
</div>
<script>
(function () {
  if (typeof window.configs !== 'object' || !window.configs) window.configs = {};
  if (typeof window.configs.preview !== 'object' || !window.configs.preview) {
    window.configs.preview = {
      browse: '/ajax/preview/browse?type=json',
      content: '/ajax/preview/preview?type=json'
    };
  }

  var state = {
    root: '',
    currentDir: '',
    parentDir: '',
    entries: [],
    selectedPath: ''
  };

  function escapeHtml(text) {
    return String(text == null ? '' : text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatBytes(bytes) {
    if (!bytes) return '0 B';
    var units = ['B', 'KB', 'MB', 'GB'];
    var value = bytes;
    var unit = units[0];
    for (var index = 0; index < units.length; index += 1) {
      unit = units[index];
      if (value < 1024 || index === units.length - 1) break;
      value = value / 1024;
    }
    return (value >= 10 || unit === 'B' ? value.toFixed(0) : value.toFixed(1)) + ' ' + unit;
  }

  function segments(path) {
    return path ? path.split('/').filter(Boolean) : [];
  }

  function renderBreadcrumbs() {
    var $crumbs = $('#preview-breadcrumbs');
    $crumbs.empty();

    var parts = segments(state.currentDir);
    var aggregate = [];
    $('<button type="button" class="is-active">/</button>')
      .on('click', function () { loadDirectory(''); })
      .appendTo($crumbs);

    parts.forEach(function (part, index) {
      aggregate.push(part);
      $('<button type="button"></button>')
        .text(part)
        .toggleClass('is-active', index === parts.length - 1)
        .on('click', function () { loadDirectory(aggregate.join('/')); })
        .appendTo($crumbs);
    });
  }

  function renderList() {
    $('#preview-root-label').text('Current root: ' + (state.root || '(not set)'));
    $('#preview-up-button').prop('disabled', state.currentDir === '');
    var $list = $('#preview-list');
    $list.empty();

    if (!state.entries.length) {
      $list.append('<li class="preview-empty">This directory is empty.</li>');
      return;
    }

    state.entries.forEach(function (entry) {
      var label = entry.is_directory ? 'Folder' : entry.preview_kind;
      var size = entry.is_directory ? '' : ' · ' + formatBytes(entry.size_bytes);
      var $button = $('<button type="button"></button>')
        .toggleClass('is-selected', state.selectedPath === entry.relative_path)
        .attr('data-path', entry.relative_path)
        .append('<span class="preview-entry-name">' + escapeHtml(entry.name) + '</span>')
        .append('<span class="preview-entry-meta">' + escapeHtml(label + size) + '</span>');

      $button.on('click', function () {
        if (entry.is_directory) {
          loadDirectory(entry.relative_path);
          return;
        }
        loadPreview(entry.relative_path);
      });

      $('<li></li>').append($button).appendTo($list);
    });
  }

  function renderPreview(payload) {
    $('#preview-selected-name').text(payload.name || 'Nothing selected');
    $('#preview-selected-meta').text((payload.mime_type || '') + (payload.size_bytes ? ' · ' + formatBytes(payload.size_bytes) : ''));

    var html = '';
    if (payload.too_large) {
      html = '<div class="preview-empty">' + escapeHtml(payload.message) + '</div>';
    } else if (payload.preview_kind === 'text') {
      html = '<pre>' + escapeHtml(payload.content || '') + '</pre>';
    } else if (payload.preview_kind === 'image') {
      html = '<img alt="' + escapeHtml(payload.name || 'preview image') + '" src="' + payload.data_url + '">';
    } else if (payload.preview_kind === 'pdf') {
      html = '<iframe title="' + escapeHtml(payload.name || 'pdf preview') + '" src="' + payload.data_url + '"></iframe>';
    } else if (payload.preview_kind === 'audio') {
      html = '<audio controls src="' + payload.data_url + '"></audio>';
    } else if (payload.preview_kind === 'video') {
      html = '<video controls src="' + payload.data_url + '"></video>';
    } else {
      html = '<div class="preview-empty">' + escapeHtml(payload.message || 'Preview is not available for this file type.') + '</div>';
    }

    $('#preview-preview-box').html(html);
  }

  function loadDirectory(path) {
    $.ajax({
      url: configs.preview.browse,
      dataType: 'json',
      data: { path: path || '' }
    }).done(function (payload) {
      state.root = payload.root || '';
      state.currentDir = payload.current_dir || '';
      state.parentDir = payload.parent_dir || '';
      state.entries = Array.isArray(payload.entries) ? payload.entries : [];
      state.selectedPath = '';
      renderBreadcrumbs();
      renderList();
      $('#preview-selected-name').text('Nothing selected');
      $('#preview-selected-meta').text('Choose a file from the list to preview it.');
      $('#preview-preview-box').html('<div class="preview-empty">No file selected yet.</div>');
    }).fail(function (xhr) {
      $('#preview-list').html('<li class="preview-empty">Unable to load the directory: ' + escapeHtml(xhr.responseText || xhr.statusText) + '</li>');
    });
  }

  function loadPreview(path) {
    $.ajax({
      url: configs.preview.content,
      dataType: 'json',
      data: { path: path }
    }).done(function (payload) {
      state.selectedPath = path;
      renderList();
      renderPreview(payload);
    }).fail(function (xhr) {
      $('#preview-preview-box').html('<div class="preview-empty">Unable to preview the file: ' + escapeHtml(xhr.responseText || xhr.statusText) + '</div>');
    });
  }

  $('#preview-root-button').on('click', function () { loadDirectory(''); });
  $('#preview-up-button').on('click', function () { loadDirectory(state.parentDir || ''); });

  renderBreadcrumbs();
  loadDirectory('');
})();
</script>
CODE1: Ajax jvar => 'configs.preview.browse', type => 'json', file => 'browse', code => q{
  BEGIN {
    my $ajax_file = $ENV{DEVELOPER_DASHBOARD_AJAX_FILE} || '';
    if ( $ajax_file ne '' ) {
      require File::Basename;
      require File::Spec;
      require lib;
      my $root = File::Basename::dirname($ajax_file);
      $root = File::Basename::dirname($root) for 1 .. 4;
      my $candidate = File::Spec->catdir( $root, 'lib' );
      lib->import($candidate) if -d $candidate;
    }
  }

  use JSON::PP qw(encode_json);
  use Preview::Directory ();
  use Preview::State ();

  my $root = Preview::State::load_root();
  my $relative = params->{path} // q{};
  my $payload = Preview::Directory::list_directory(
    root     => $root,
    relative => $relative,
  );

  print encode_json($payload);
};
