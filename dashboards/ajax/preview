  BEGIN {
    my $ajax_file = $ENV{DEVELOPER_DASHBOARD_AJAX_FILE} || '';
    if ( $ajax_file ne '' ) {
      require File::Basename;
      require File::Spec;
      require lib;
      my $cursor = File::Basename::dirname($ajax_file);
      for ( 1 .. 6 ) {
        my $candidate = File::Spec->catdir( $cursor, 'lib' );
        my $module    = File::Spec->catfile( $candidate, 'Preview', 'Directory.pm' );
        if ( -f $module ) {
          lib->import($candidate);
          last;
        }

        my $parent = File::Basename::dirname($cursor);
        last if !defined $parent || $parent eq $cursor;
        $cursor = $parent;
      }
    }
  }

  use JSON::PP qw(encode_json);
  use Preview::Directory ();
  use Preview::State ();

  my $root = Preview::State::load_root();
  my $relative = params->{path} // q{};
  my $payload = Preview::Directory::preview_file(
    root     => $root,
    relative => $relative,
  );

  print encode_json($payload);
